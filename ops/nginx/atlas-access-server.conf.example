# Include from the Atlas public server {} block.
# This is additive: do not replace the existing root/service locations.

access_log /var/log/nginx/atlas-access.jsonl atlas_access;

location ^~ /admin/ {
    try_files $uri $uri/ /admin/index.html;
}

location ^~ /api/atlas-admin/ {
    proxy_pass http://127.0.0.1:8787;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Admin responses must not be cached by nginx or an upstream cache.
    add_header Cache-Control "no-store" always;
}
