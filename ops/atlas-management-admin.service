[Unit]
Description=Atlas Management authenticated usage-log API
After=network.target nginx.service
Wants=nginx.service

[Service]
Type=simple
User=nginx
Group=nginx
WorkingDirectory=/opt/atlas-management-admin/current
EnvironmentFile=/etc/atlas-management-admin.env
ExecStart=/usr/bin/node /opt/atlas-management-admin/current/server/admin-server.mjs
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/nginx

[Install]
WantedBy=multi-user.target
